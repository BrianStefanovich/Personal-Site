# Public canonical origin used for canonical URLs, sitemap entries, and robots.txt.
PUBLIC_SITE_URL=https://your-domain.example

# Optional Google Tag Manager container ID. When set, GTM is injected in production builds and receives
# `data-track` events through the dataLayer. Configure GA4 and other tags inside the container.
PUBLIC_GTM_ID=GTM-XXXXXXX

# Optional GA4 measurement ID, used only when PUBLIC_GTM_ID is empty. Emitted only for production builds.
PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX