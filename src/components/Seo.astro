---
import { defaultLocale, locales, type Locale } from '@/i18n/config';
import { getTranslations } from '@/i18n';
import { absoluteUrl, alternatesFor, buildJsonLd, ogLocale, serializeJsonLd, type BreadcrumbItem, type JsonLd } from '@/lib/seo';

interface Props {
	title?: string;
	description: string;
	image?: string;
	imageAlt?: string;
	canonicalPath?: string;
	noindex?: boolean;
	type?: 'website' | 'article';
	breadcrumbs?: readonly BreadcrumbItem[];
	jsonLd?: readonly JsonLd[];
}

const {
	title,
	description,
	image = '/og-default.png',
	imageAlt,
	canonicalPath = '/',
	noindex = false,
	type = 'website',
	breadcrumbs,
	jsonLd,
} = Astro.props;
const locale = (Astro.currentLocale ?? defaultLocale) as Locale;
const site = new URL(Astro.site ?? 'https://brianstefanovich.com');
// Static output serves every route as a directory, and the sitemap lists them with a trailing slash; the canonical must match.
const canonical = absoluteUrl(canonicalPath, site);
const imageUrl = new URL(image, site).toString();
const pageTitle = title ?? getTranslations(locale).home.meta.title;
const alternates = noindex ? [] : alternatesFor(canonicalPath, site);
const structuredData = noindex
	? null
	: buildJsonLd({ site, locale, url: canonical, title: pageTitle, description, image: imageUrl, breadcrumbs, extra: jsonLd });
---

<title>{pageTitle}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
{alternates.map((alternate) => <link rel="alternate" hreflang={alternate.hreflang} href={alternate.href} />)}
{noindex ? <meta name="robots" content="noindex, nofollow" /> : <meta name="robots" content="index, follow, max-image-preview:large" />}
<meta property="og:type" content={type} />
<meta property="og:site_name" content="Brian Stefanovich" />
<meta property="og:locale" content={ogLocale(locale)} />
{alternates.length > 0 && locales.filter((other) => other !== locale).map((other) => <meta property="og:locale:alternate" content={ogLocale(other)} />)}
<meta property="og:title" content={pageTitle} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={imageUrl} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={imageAlt ?? pageTitle} />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={pageTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={imageUrl} />
<meta name="twitter:image:alt" content={imageAlt ?? pageTitle} />
{structuredData && <script type="application/ld+json" set:html={serializeJsonLd(structuredData)} />}
