---
import BaseLayout from '@/layouts/BaseLayout.astro';
import CtaFinal from '@/components/sections/CtaFinal';
import Hero from '@/components/sections/Hero';
import { getTranslations } from '@/i18n';

const { sobreMi: page } = getTranslations();
---

<BaseLayout title={page.meta.title} description={page.meta.description} canonicalPath="/sobre-mi">
	<Hero client:load content={page.hero} />

	<section class="container flex flex-col gap-4 py-12 md:py-[64px]">
		<h2 class="font-display text-2xl leading-8 font-semibold text-foreground">{page.enfoque.heading}</h2>
		{page.enfoque.paragraphs.map((paragraph) => (
			<p class="text-[15px] leading-6 text-body md:text-base">{paragraph}</p>
		))}
	</section>

	<section class="container flex flex-col gap-4 py-12 md:py-[64px]">
		<h2 class="font-display text-2xl leading-8 font-semibold text-foreground">{page.experienciaList.heading}</h2>
		<ul class="flex flex-col gap-2 md:grid md:grid-cols-2 md:gap-x-8 md:gap-y-2">
			{page.experienciaList.items.map((item) => (
				<li class="flex items-start gap-3">
					<img src="/images/icon-check.svg" alt="" width="14" height="10" class="mt-[7px] shrink-0" />
					<span class="text-[15px] leading-6 text-body md:text-base">{item}</span>
				</li>
			))}
		</ul>
		<p class="pt-2 text-[15px] leading-6 text-body md:text-base">{page.experienciaList.trayectoria}</p>
	</section>

	<section class="container flex flex-col gap-4 py-12 md:py-[64px]">
		<h2 class="font-display text-2xl leading-8 font-semibold text-foreground">{page.comoEsTrabajar.heading}</h2>
		<ul class="flex flex-col gap-2">
			{page.comoEsTrabajar.items.map((item) => (
				<li class="flex items-start gap-3">
					<img src="/images/icon-check.svg" alt="" width="14" height="10" class="mt-[7px] shrink-0" />
					<span class="text-[15px] leading-6 text-body md:text-base">{item}</span>
				</li>
			))}
		</ul>
	</section>

	<CtaFinal content={{ heading: page.cta.heading, ctaLabel: page.cta.ctaLabel, ctaHref: page.cta.ctaHref }} />
</BaseLayout>
