---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { CaseDetail } from '@/components/casos/CaseDetail';
import { getTranslations } from '@/i18n';

export function getStaticPaths() {
	const { casos } = getTranslations().home;
	return casos.items.map((item) => ({
		params: { caso: item.slug },
		props: { item },
	}));
}

const { item } = Astro.props;
---

<BaseLayout
	title={`${item.name} — ${item.card.headline} | Brian Stefanovich`}
	description={item.card.body}
	canonicalPath={`/casos/${item.slug}`}
>
	<CaseDetail slug={item.slug} client:visible />
</BaseLayout>
