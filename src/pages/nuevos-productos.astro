---
import BaseLayout from '@/layouts/BaseLayout.astro';
import CtaFinal from '@/components/sections/CtaFinal';
import Hero from '@/components/sections/Hero';
import ProcessSteps from '@/components/sections/ProcessSteps';
import Sprint from '@/components/sections/Sprint';
import { getTranslations } from '@/i18n';

const { nuevosProductos: page } = getTranslations();
---

<BaseLayout title={page.meta.title} description={page.meta.description} canonicalPath="/nuevos-productos">
	<Hero client:load content={page.hero} />

	<section class="container flex flex-col gap-6 py-12 md:py-[64px]">
		<h2 class="font-display text-[36px] leading-[43px] font-semibold text-foreground text-balance md:max-w-[768px] md:text-[44px] md:leading-[54px]">
			{page.cuandoTieneSentido.heading}
		</h2>
		<ul class="flex flex-col gap-3 md:grid md:grid-cols-2 md:gap-4">
			{page.cuandoTieneSentido.items.map((item) => (
				<li class="flex items-start gap-3 rounded-[2px] border border-line bg-surface p-4">
					<img src="/images/icon-check.svg" alt="" width="14" height="10" class="mt-[7px] shrink-0" />
					<span class="text-[15px] leading-6 text-body">{item}</span>
				</li>
			))}
		</ul>
	</section>

	<Sprint client:visible content={page.blueprint} />

	<ProcessSteps heading={page.proceso.heading} steps={page.proceso.steps} />

	<section class="container flex flex-col gap-4 py-12 md:py-[64px]">
		<h2 class="font-display text-2xl leading-8 font-semibold text-foreground">{page.queNoPrometo.heading}</h2>
		<ul class="flex flex-col gap-2">
			{page.queNoPrometo.items.map((item) => (
				<li class="flex items-start gap-3">
					<img src="/images/icon-dash.svg" alt="" width="14" height="2" class="mt-3 shrink-0" />
					<span class="text-[15px] leading-6 text-body md:text-base">{item}</span>
				</li>
			))}
		</ul>
	</section>

	<CtaFinal content={page.ctaFinal} />
</BaseLayout>
