---
import BaseLayout from '@/layouts/BaseLayout.astro';
import CasesList from '@/components/sections/CasesList';
import ContactSection from '@/components/sections/ContactSection';
import { es } from '@/i18n/es';

const { meta } = es.home.cases;
---

<BaseLayout title={meta.title} description={meta.description} canonicalPath="/cases" breadcrumbs={[{ name: es.nav.links[1].label, path: '/cases' }]}>
	<CasesList />
	<ContactSection client:visible />
</BaseLayout>
