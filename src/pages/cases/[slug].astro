---
import BaseLayout from '@/layouts/BaseLayout.astro';
import CaseDetail from '@/components/sections/CaseDetail';
import ContactSection from '@/components/sections/ContactSection';
import { es } from '@/i18n/es';

export function getStaticPaths() {
	return es.home.cases.items.map((item) => ({ params: { slug: item.slug }, props: { item } }));
}

const { item } = Astro.props;
const title = `${item.seoTitle ?? item.name} | ${es.home.cases.meta.titleSuffix}`;
---

<BaseLayout title={title}
	description={item.card}
	canonicalPath={`/cases/${item.slug}`}
	breadcrumbs={[
		{ name: es.nav.links[1].label, path: '/cases' },
		{ name: item.name, path: `/cases/${item.slug}` },
	]}
>
	<CaseDetail client:load item={item} />
	<ContactSection client:visible />
</BaseLayout>
