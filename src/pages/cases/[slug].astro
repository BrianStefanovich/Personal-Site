---
import BaseLayout from '@/layouts/BaseLayout.astro';
import CasoDetalle from '@/components/sections/CasoDetalle';
import { es } from '@/i18n/es';

export function getStaticPaths() {
	return es.home.casos.items.map((item) => ({ params: { slug: item.slug }, props: { item } }));
}

const { item } = Astro.props;
---

<BaseLayout title={`${item.name} | Casos | Brian Stefanovich`} description={item.headline} canonicalPath={`/cases/${item.slug}`}>
	<CasoDetalle client:load item={item} />
</BaseLayout>
