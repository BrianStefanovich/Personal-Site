---
import BaseLayout from '@/layouts/BaseLayout.astro';
import CtaFinal from '@/components/sections/CtaFinal';
import Experiencia from '@/components/sections/Experiencia';
import Hero from '@/components/sections/Hero';
import { getTranslations } from '@/i18n';

const { experienciaPage: page } = getTranslations();
---

<BaseLayout title={page.meta.title} description={page.meta.description} canonicalPath="/experiencia">
	<Hero client:load content={page.hero} />

	<Experiencia content={{ heading: 'Casos ampliados', intro: page.intro, casos: page.casos }} />

	<p class="container pb-12 text-sm leading-6 text-muted md:pb-[64px]">{page.nota}</p>

	<CtaFinal content={page.cta} />
</BaseLayout>
