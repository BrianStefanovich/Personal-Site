---
import BaseLayout from '@/layouts/BaseLayout.astro';
import CtaFinal from '@/components/sections/CtaFinal';
import Hero from '@/components/sections/Hero';
import { getTranslations } from '@/i18n';

const { recursosPage: page } = getTranslations();
---

<BaseLayout title={page.meta.title} description={page.meta.description} canonicalPath="/recursos">
	<Hero client:load content={page.hero} />
	<CtaFinal content={page.cta} />
</BaseLayout>
