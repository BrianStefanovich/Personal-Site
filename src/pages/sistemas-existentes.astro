---
import BaseLayout from '@/layouts/BaseLayout.astro';
import CtaFinal from '@/components/sections/CtaFinal';
import Hero from '@/components/sections/Hero';
import ProcessSteps from '@/components/sections/ProcessSteps';
import { buttonVariants } from '@/components/ui/button';
import { getTranslations } from '@/i18n';
import { cn } from '@/lib/utils';

const { sistemasExistentes: page } = getTranslations();
---

<BaseLayout title={page.meta.title} description={page.meta.description} canonicalPath="/sistemas-existentes">
	<Hero client:load content={page.hero} />

	<section class="container flex flex-col gap-6 py-12 md:py-[64px]">
		<h2 class="font-display text-[36px] leading-[43px] font-semibold text-foreground text-balance md:max-w-[768px] md:text-[44px] md:leading-[54px]">
			{page.situaciones.heading}
		</h2>
		<ul class="flex flex-col gap-3 md:grid md:grid-cols-2 md:gap-4">
			{page.situaciones.items.map((item) => (
				<li class="flex items-start gap-3 rounded-[2px] border border-line bg-surface p-4">
					<img src="/images/icon-dash.svg" alt="" width="14" height="2" class="mt-3 shrink-0" />
					<span class="text-[15px] leading-6 text-body">{item}</span>
				</li>
			))}
		</ul>
	</section>

	<ProcessSteps heading={page.queHago.heading} steps={page.queHago.steps} />

	<section class="container flex flex-col gap-6 py-12 md:py-[64px]">
		<div class="flex flex-col gap-4 rounded-[2px] border border-line bg-[#f1ede5] p-6 md:p-8">
			<h2 class="font-display text-2xl leading-8 font-semibold text-foreground md:text-[32px] md:leading-10">
				{page.ofertaRecomendada.heading}
			</h2>
			<p class="text-[15px] leading-6 text-body md:text-base">{page.ofertaRecomendada.text}</p>
			<dl class="flex flex-col gap-2 border-t border-line pt-4 md:flex-row md:gap-8">
				{page.ofertaRecomendada.facts.map((fact) => (
					<div class="text-sm leading-5 text-body">
						<dt class="inline font-display font-semibold text-foreground">{fact.label}:</dt>
						<dd class="inline"> {fact.value}</dd>
					</div>
				))}
			</dl>
			<a
				href={page.ofertaRecomendada.ctaHref}
				class={cn(buttonVariants(), 'self-start')}
			>
				{page.ofertaRecomendada.ctaLabel}
			</a>
		</div>
	</section>

	<section class="container flex flex-col gap-4 py-12 md:py-[64px]">
		<h2 class="font-display text-2xl leading-8 font-semibold text-foreground">{page.resultado.heading}</h2>
		<ul class="flex flex-col gap-2">
			{page.resultado.items.map((item) => (
				<li class="flex items-start gap-3">
					<img src="/images/icon-check.svg" alt="" width="14" height="10" class="mt-[7px] shrink-0" />
					<span class="text-[15px] leading-6 text-body md:text-base">{item}</span>
				</li>
			))}
		</ul>
	</section>

	<CtaFinal content={page.ctaFinal} />
</BaseLayout>
