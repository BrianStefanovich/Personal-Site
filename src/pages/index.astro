---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Continuidad from '@/components/sections/Continuidad';
import CtaFinal from '@/components/sections/CtaFinal';
import Diagnostico from '@/components/sections/Diagnostico';
import Diferenciales from '@/components/sections/Diferenciales';
import Encaje from '@/components/sections/Encaje';
import Experiencia from '@/components/sections/Experiencia';
import Faq from '@/components/sections/Faq';
import Hero from '@/components/sections/Hero';
import ProcessSteps from '@/components/sections/ProcessSteps';
import Problemas from '@/components/sections/Problemas';
import SobreBrian from '@/components/sections/SobreBrian';
import { getTranslations } from '@/i18n';

const t = getTranslations();
const { home } = t;
---

<BaseLayout title={home.meta.title} description={home.meta.description} canonicalPath="/">
	<Hero client:load content={home.hero} />
	<Problemas client:visible content={home.problemas} />
	<Diagnostico client:visible content={home.diagnostico} />
	<ProcessSteps
		id="como-trabajo"
		number={home.comoTrabajo.number}
		short={home.comoTrabajo.short}
		long={home.comoTrabajo.long}
		heading={home.comoTrabajo.heading}
		steps={home.comoTrabajo.steps}
	/>
	<Continuidad client:visible content={home.continuidad} />
	<Experiencia id="experiencia" content={home.experiencia} />
	<Diferenciales client:visible content={home.diferenciales} />
	<Encaje client:visible content={home.encaje} />
	<SobreBrian client:visible content={home.sobreBrian} />
	<Faq client:visible content={home.faq} />
	<CtaFinal content={home.ctaFinal} />
</BaseLayout>
