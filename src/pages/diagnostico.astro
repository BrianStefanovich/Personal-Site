---
import BaseLayout from '@/layouts/BaseLayout.astro';
import CtaFinal from '@/components/sections/CtaFinal';
import Hero from '@/components/sections/Hero';
import ProcessSteps from '@/components/sections/ProcessSteps';
import { getTranslations } from '@/i18n';

const { diagnosticoPage: page } = getTranslations();
---

<BaseLayout title={page.meta.title} description={page.meta.description} canonicalPath="/diagnostico">
	<Hero client:load content={page.hero} />

	<section class="container flex flex-col gap-6 py-12 md:py-[64px]">
		<h2 class="font-display text-2xl leading-8 font-semibold text-foreground">{page.paraQuienEs.heading}</h2>
		<ul class="flex flex-col gap-2">
			{page.paraQuienEs.items.map((item) => (
				<li class="flex items-start gap-3">
					<img src="/images/icon-check.svg" alt="" width="14" height="10" class="mt-[7px] shrink-0" />
					<span class="text-[15px] leading-6 text-body md:text-base">{item}</span>
				</li>
			))}
		</ul>
	</section>

	<section class="container flex flex-col gap-6 py-12 md:py-[64px]">
		<h2 class="font-display text-2xl leading-8 font-semibold text-foreground">{page.preguntas.heading}</h2>
		<ul class="flex flex-col gap-2">
			{page.preguntas.items.map((item) => (
				<li class="flex items-start gap-3">
					<span aria-hidden class="mt-2 h-px w-2 shrink-0 bg-muted"></span>
					<span class="text-[15px] leading-6 text-body md:text-base">{item}</span>
				</li>
			))}
		</ul>
	</section>

	<ProcessSteps heading={page.proceso.heading} steps={page.proceso.steps} />

	<section class="container flex flex-col gap-6 py-12 md:py-[64px]">
		<h2 class="font-display text-2xl leading-8 font-semibold text-foreground">{page.entregables.heading}</h2>
		<ul class="flex flex-col gap-2 md:grid md:grid-cols-2 md:gap-x-8 md:gap-y-2">
			{page.entregables.items.map((item) => (
				<li class="flex items-start gap-3">
					<img src="/images/icon-check.svg" alt="" width="14" height="10" class="mt-[7px] shrink-0" />
					<span class="text-[15px] leading-6 text-body md:text-base">{item}</span>
				</li>
			))}
		</ul>
	</section>

	<section class="container flex flex-col gap-8 py-12 md:grid md:grid-cols-2 md:gap-8 md:py-[64px]">
		<div class="flex flex-col gap-2 rounded-[2px] border border-line bg-surface p-6">
			<h2 class="font-display text-xl leading-7 font-semibold text-foreground">{page.limites.heading}</h2>
			<p class="text-[15px] leading-6 text-body">{page.limites.text}</p>
		</div>
		<div class="flex flex-col gap-2 rounded-[2px] border border-line bg-surface p-6">
			<h2 class="font-display text-xl leading-7 font-semibold text-foreground">{page.despues.heading}</h2>
			<p class="text-[15px] leading-6 text-body">{page.despues.text}</p>
		</div>
	</section>

	<CtaFinal content={page.ctaFinal} />
</BaseLayout>
